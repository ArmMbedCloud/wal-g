# Stage placement for `make deploy MACHINE=<stage>`; stamped from IzumaNetworks/nucloud
# templates/iz, identical in every repo. izmachine reads global.iz, then this file,
# then the untracked .izlocal beside it; a later layer replaces an earlier one per machine.
# Private machines (k3s-cypress on cypressLinux) live in .izlocal.

[machine.k3s-ed]
provider  = "incus"
remote    = "D71"
kind      = "vm"
os        = "ubuntu"
osversion = "22.04"
image     = "images:ubuntu/jammy/cloud"

[machine.k3s-trav]
provider  = "incus"
remote    = "D71"
kind      = "vm"
os        = "ubuntu"
osversion = "22.04"
image     = "images:ubuntu/jammy/cloud"

# Production stage: nucloud builds are never deployed here (docs/nucloud.md).
[machine.k3s-golden]
provider  = "incus"
remote    = "D71"
kind      = "vm"
os        = "ubuntu"
osversion = "22.04"
image     = "images:ubuntu/jammy/cloud"
